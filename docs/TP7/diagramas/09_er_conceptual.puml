@startuml 09_er_conceptual
!include _estilo.iuml
title Modelo de Base de Datos - Diagrama Entidad-Relación Conceptual (LSA Salud)

skinparam linetype ortho

package "Sistema de archivos (artefactos binarios del modelo)" {
    class ClaseDeSeña {
        etiqueta
    }

    class MuestraDeEntrenamiento {
        timestamp
        cantidadDeFrames
        cantidadDeCoeficientesDeBlendshapes
    }

    class VocabularioDelModelo {
        indice
        etiqueta
    }

    class ModeloDeReconocimiento {
        nombreDeArchivo
        framesPorMuestra
    }

    class ArchivoDeVoz {
        nombreDeArchivo
        configuracion
    }
}

package "Base de datos SQLite (data/lsa_salud.db)" {
    class MensajeReportado {
        idMensajeCliente
        texto
        primeraMarcaDeReporte
    }

    class PalabraReconocida {
        posicion
        palabra
    }

    class ReporteDeTraducción {
        estacionQueReporta
        marcaTemporal
    }

    class EventoDeAuditoría {
        tipo {prediction | sentence | report |\nconsent | translation_displayed |\nreply_sent | fin_atencion}
        marcaTemporal
        estacion
        camposSegúnTipo
    }
}

package "Memoria del navegador (no persistido)" {
    class Mensaje <<volátil>> {
        id
        rol
        texto
        hora
        reportado
    }
}

ClaseDeSeña "1" -- "0..*" MuestraDeEntrenamiento : ejemplifica >
ClaseDeSeña "1" -- "0..*" VocabularioDelModelo : aparece en >
VocabularioDelModelo "0..*" -- "1" ModeloDeReconocimiento : pertenece a >

Mensaje "1" -- "0..1" MensajeReportado : se persiste como >
MensajeReportado "1" -- "1..*" ReporteDeTraducción : es señalado por >
MensajeReportado "1" *-- "0..20" PalabraReconocida : se tradujo a partir de >
PalabraReconocida "0..*" -- "0..1" ClaseDeSeña : corresponde a >

' --- Enlaces ocultos: ordenan el layout (no semántica) ---
MuestraDeEntrenamiento -[hidden]-> ClaseDeSeña
ModeloDeReconocimiento -[hidden]-> ArchivoDeVoz
ReporteDeTraducción -[hidden]-> EventoDeAuditoría

note right of Mensaje
  Vive solo como estado de React
  (BroadcastChannel). Únicamente
  el mensaje que alguien reporta
  (CU-10) se copia a la base de
  datos como MensajeReportado; el
  resto de la conversación nunca
  llega a disco (RNF-03.1).
end note

note bottom of EventoDeAuditoría
  El consentimiento (RF-03) no es una
  entidad propia: es un EventoDeAuditoría
  con tipo = "consent". Anónimo.
end note

note bottom of ArchivoDeVoz
  Activo de terceros (Piper TTS),
  sin relación con el resto.
end note

@enduml
