@startuml 06_proceso_4_sincronizacion
!include _estilo.iuml
hide footbox
skinparam maxMessageSize 160

title Proceso 4 — Envío del mensaje del paciente al personal (CU-01)

actor Paciente
participant "Estación\ndel Paciente" as NavP
participant "Canal de\nla estación" as BC
participant "Estación\nde Recepción" as NavR
actor "Personal de\nRecepción o\nEnfermería" as Personal

NavP -> Paciente : agrega el mensaje\na su conversación
NavP -> BC : postMessage\n(MESSAGE)
BC -> NavR : evento MESSAGE
NavR -> Personal : muestra el mensaje\ndel paciente

@enduml
