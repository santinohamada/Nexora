@startuml 06_proceso_7_fin_atencion
!include _estilo.iuml
hide footbox
skinparam maxMessageSize 160

title Proceso 7 — Fin de atención (CU-12, RNF-03)

actor Paciente
participant "Estación\ndel Paciente" as NavP
participant "Canal de\nla estación" as BC
participant "FastAPI\n(threadpool)" as API
participant "Estación\nde Recepción" as NavR
actor "Personal de\nRecepción o\nEnfermería" as Personal

Personal -> NavR : "Finalizar atención"
NavR -> NavR : vacía la conversación
NavR -> BC : postMessage\n(CLEAR)
BC -> NavP : evento CLEAR
NavP -> NavP : vacía la conversación
NavP -> Paciente : la estación queda lista\npara el próximo paciente
NavR -> API : POST /audit\n(fin_atencion)
API -> API : registra el evento anónimo

@enduml
