@startuml 06_vista_desarrollo
!include _estilo.iuml

title Vista de Desarrollo — Estructura del repositorio LSA Salud

package "web/" as Web {
  package "app/" as WebApp
  package "hooks/" as WebHooks
  package "components/" as WebComponents
  package "lib/" as WebLib
}

package "src/" as Src {
  package "model/" as SrcModel
}

component "app.py" as AppPy
component "train_lstm.py" as TrainLstm
component "capture_validation.py" as CaptureVal

folder "dataset/" as Dataset
folder "models/" as Models
folder "voices/" as Voices
folder "docs/" as Docs
folder "logs/" as Logs <<diseñado>>
component "audit_log.py" as AuditLog <<diseñado>>

WebApp ..> WebHooks : usa
WebApp ..> WebComponents : usa
WebHooks ..> WebLib : usa
WebComponents ..> WebLib : usa

WebHooks ..> AppPy : HTTP / WS
WebComponents ..> AppPy : HTTP

AppPy ..> SrcModel : usa
AppPy ..> CaptureVal : usa
AppPy ..> Dataset : lee/escribe .npy
AppPy ..> Models : lee pesos (.pth)
AppPy ..> Voices : lee modelo Piper (.onnx)

TrainLstm ..> Dataset : lee muestras
TrainLstm ..> SrcModel : usa
TrainLstm ..> Models : escribe pesos

AppPy ..> AuditLog : usa (RF-04.1, diseñado)
AuditLog ..> Logs : escribe eventos/reportes\n(JSON Lines, diseñado)

note bottom of Docs
  Documentación del proyecto
  (este entregable y los demás).
  Sin dependencias de código.
end note

note bottom of Logs
  audit_log.py y logs/ son diseño,
  pendientes de implementación
  (RF-03/04/06 oficiales).
end note

@enduml
