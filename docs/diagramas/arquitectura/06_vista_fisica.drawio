"><mxGeometry x="60" y="680" width="480" height="60" as="geometry"/></mxCell><mxCell id="note" value="Cada estación es una instancia local independiente: navegador, Next.js, FastAPI, Ollama y almacenamiento local propio. No hay servidor central ni datos compartidos entre estaciones (RNF-T-02, RNF-03); cada una conserva su propia conversación mientras dura la atención." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8860B;fontSize=12;fontFamily=Helvetica;align=left;spacingLeft=6;size=14;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="540" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>