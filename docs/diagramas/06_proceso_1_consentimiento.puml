@startuml 06_proceso_1_consentimiento
!include _estilo.iuml
hide footbox
skinparam maxMessageSize 160

title Proceso 1 — Consentimiento de cámara (CU-09, RF-03)

actor Paciente
participant "Estación\ndel Paciente" as NavP
participant "FastAPI\n(threadpool)" as API

Paciente -> NavP : llega a la estación
NavP -> Paciente : muestra el diálogo\nde consentimiento\n(cámara apagada)
alt el paciente acepta
  Paciente -> NavP : "Acepto y continúo"
  NavP -> NavP : habilita la cámara
  NavP -> API : POST /audit\n(consent: accepted)
else el paciente no acepta
  Paciente -> NavP : "No acepto"
  NavP -> Paciente : explica que se necesita\nla cámara y ofrece\nreconsiderar
  NavP -> API : POST /audit\n(consent: declined)
end
API -> API : registra el evento\nen logs/audit.jsonl

@enduml
