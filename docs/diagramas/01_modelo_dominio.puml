@startuml 01_modelo_dominio
!include _estilo.iuml

title Modelo de Dominio — LSA Salud

hide methods
hide circle

class Paciente {
}

class "Personal de Recepción\no Enfermería" as Personal {
}

class "Desarrollador de IA /\nEquipo de Proyecto" as DevIA {
}

class EstaciónDeAtención {
  tipo
}

class Conversación {
  fechaInicio
}

class Mensaje {
  texto
  rolEmisor
  horaEnvío
}

class SecuenciaDeSeñas {
  estado
  marcaTemporalInicio
}

class ClaseDeSeña {
  nombre
}

class PalabraReconocida {
  confianza
  posición
  marcaTemporal
}

class Traducción {
  textoOriginal
  textoTraducido
  fuente
}

class "PlantillaMédica" as PlantillaMedica {
  combinaciónDeSeñas
  fraseResultante
}

class SíntesisDeVoz {
  voz
  formatoAudio
}

class ModeloDeReconocimiento {
  versión
  cantidadDeClases
  exactitudDeValidación
}

class MuestraDeEntrenamiento {
  cantidadDeFrames
  fechaCaptura
  modoDeCaptura
}

' --- Conceptos diseñados, pendientes de implementación (RF-03/04/06 oficiales) ---
class ConsentimientoDeCámara {
  otorgado
  marcaTemporal
}

class EventoDeAuditoría {
  tipoDeOperación
  marcaTemporal
  resultado
}

class ReporteDeTraducción {
  motivo
  marcaTemporal
}

' --- Asociaciones: personas y estaciones ---------------------------------
Paciente "1" -- "1" EstaciónDeAtención : utiliza >
Personal "1" -- "1" EstaciónDeAtención : utiliza >
EstaciónDeAtención "2" -- "1" Conversación : muestra >
EstaciónDeAtención "1" -- "0..*" EventoDeAuditoría : origina >

' --- Asociaciones: comunicación --------------------------------------------
Paciente "1" -- "0..1" ConsentimientoDeCámara : otorga >
Paciente "1" -- "0..*" SecuenciaDeSeñas : realiza >
SecuenciaDeSeñas "1" *-- "1..*" PalabraReconocida : compuesta por >
PalabraReconocida "0..*" -- "1" ClaseDeSeña : corresponde a >
SecuenciaDeSeñas "1" -- "0..1" Traducción : da origen a >
Traducción "0..*" -- "0..1" PlantillaMedica : puede basarse en >
Traducción "1" -- "1" Mensaje : genera >
Mensaje "1" -- "0..1" SíntesisDeVoz : tiene >
Mensaje "0..*" -- "1" Conversación : pertenece a >
Mensaje "1" -- "0..1" ReporteDeTraducción : puede tener >
Paciente "1" -- "0..*" ReporteDeTraducción : señala >
Personal "1" -- "0..*" ReporteDeTraducción : señala >
Personal "1" -- "0..*" Mensaje : redacta >

' --- Asociaciones: gestión del modelo ---------------------------------------
DevIA "1" -- "0..*" MuestraDeEntrenamiento : captura >
MuestraDeEntrenamiento "0..*" -- "1" ClaseDeSeña : ejemplifica >
DevIA "1" -- "0..*" ModeloDeReconocimiento : entrena >
ModeloDeReconocimiento "1" -- "1..*" ClaseDeSeña : reconoce >
ModeloDeReconocimiento "1" -- "0..*" PalabraReconocida : clasifica >

@enduml
