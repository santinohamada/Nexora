@startuml 09_modelo_logico
!include _estilo.iuml
title Modelo de Base de Datos - Modelo Lógico (notación pata de gallo)\nNota: cada "entidad" es un patrón de archivo/directorio, no una tabla de una base de datos relacional

entity "MuestraDeEntrenamiento" as MDE {
    * etiqueta : varchar(32) <<PK, FK>>
    * timestamp_ms : bigint <<PK>>
    --
    arbol : varchar {legacy | tasks}
    shape : varchar = '(45,75,4)'
}

entity "MuestraDeBlendshapes" as MBS {
    * etiqueta : varchar(32) <<PK, FK>>
    * timestamp_ms : bigint <<PK, FK>>
    --
    shape : varchar = '(45,52)'
}

entity "ClaseDeSeña" as CDS {
    * etiqueta : varchar(32) <<PK>>
}

entity "VocabularioDelModelo" as VOC {
    * indice : int <<PK>>
    --
    etiqueta : varchar(32) <<FK>>
}

entity "ModeloDeReconocimiento" as MOD {
    * archivo : varchar <<PK>>
    --
    framesPorMuestra : int
}

entity "EventoDeAuditoría" as EDA {
    (sin PK: una línea JSON más\nen logs/audit.jsonl, sin id)
    --
    tipo : varchar {prediction | sentence |\nreport | consent | translation_displayed}
    timestamp : varchar (ISO 8601 UTC)
    lstm_ms, confidence : float (tipo=prediction)
    translation_ms, tts_ms, total_ms,\nsource, word_count : (tipo=sentence)
    station : varchar (report | consent | translation_displayed)
    consent : varchar {accepted | declined} (tipo=consent)
    e2e_ms : float (tipo=translation_displayed)
}

entity "ReporteDeTraducción" as RDT {
    (sin PK: una línea JSON más\nen logs/reports.jsonl, sin id)
    --
    texto : varchar(500)
    estacion : varchar {paciente | recepcion}
    palabras : varchar[] {nullable}
    timestamp : varchar (ISO 8601 UTC)
}

CDS ||--o{ MDE : etiqueta
MDE ||--o| MBS : "etiqueta + timestamp_ms"
CDS ||--o{ VOC : etiqueta
MOD ||--|{ VOC : "vocabulario de"

' --- Enlaces ocultos: fuerzan dos columnas verticales angostas (layout, no semántica) ---
MBS -[hidden]-> MDE
MDE -[hidden]-> CDS
CDS -[hidden]-> VOC
VOC -[hidden]-> MOD
EDA -[hidden]-> RDT

note top of MDE
  PK compuesta = ruta fisica
  (directorio <etiqueta> +
  archivo <timestamp_ms>.npy)
end note

note bottom of MOD
  archivo in {lstm_v1_<N>frames.pth,
  lstm_v2_24frames.pth, lstm.pth}
end note

note bottom of RDT
  EventoDeAuditoría y ReporteDeTraducción:
  sin FK hacia el resto del modelo
  (persistencia independiente, anonima,
  formato JSON Lines). El consentimiento
  (RF-03) no tiene entidad propia: es
  un EventoDeAuditoría con tipo="consent".
end note

@enduml
