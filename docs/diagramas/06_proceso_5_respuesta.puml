@startuml 06_proceso_5_respuesta
!include _estilo.iuml
hide footbox
skinparam maxMessageSize 160

title Proceso 5 — Respuesta del personal (CU-04, CU-05, RF-02)

actor Paciente
participant "Estación\ndel Paciente" as NavP
participant "Canal de\nla estación" as BC
participant "Estación\nde Recepción" as NavR
actor "Personal de\nRecepción o\nEnfermería" as Personal

alt respuesta escrita
  Personal -> NavR : escribe la respuesta
else respuesta dictada
  Personal -> NavR : dicta la respuesta
  NavR -> NavR : transcribe la voz\n(reconocimiento del navegador)
end
NavR -> NavR : agrega la respuesta\na su conversación
NavR -> BC : postMessage(MESSAGE)
BC -> NavP : evento MESSAGE
NavP -> Paciente : muestra la respuesta

@enduml
