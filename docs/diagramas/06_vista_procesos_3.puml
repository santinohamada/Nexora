@startuml 06_vista_procesos_3
!include _estilo.iuml

title Vista de Procesos (3/3) — Sincronización, respuesta y fin de atención
skinparam maxMessageSize 130

actor Paciente
participant "Estación del Paciente\n(navegador)" as NavP
participant "BroadcastChannel\n(canal de la estación)" as BC
participant "Estación de Recepción\n(navegador)" as NavR
actor "Personal de Recepción\no Enfermería" as Personal

== Sincronización del mensaje del paciente (RF-01) ==
NavP -> BC : postMessage(MESSAGE)\n(mismo origen, sin red)
BC -> NavR : evento MESSAGE
NavR -> Personal : muestra el mensaje

== Respuesta del personal (RF-02) ==
Personal -> NavR : escribe o dicta la respuesta
NavR -> BC : postMessage(MESSAGE)
BC -> NavP : evento MESSAGE
NavP -> Paciente : muestra la respuesta

== Fin de atención (CU-12) ==
Personal -> NavR : finaliza la atención
NavR -> NavR : vacía la conversación
NavR -> BC : postMessage(CLEAR)
BC -> NavP : evento CLEAR
NavP -> NavP : vacía la conversación

@enduml
