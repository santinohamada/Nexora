@startuml 06_vista_procesos_3
!include _estilo.iuml

title Vista de Procesos (3/3) — Sincronización entre estaciones y respuesta
skinparam maxMessageSize 130

participant "Navegador\nEstación Paciente" as NavP
participant "BroadcastChannel\nnexora-chat" as BC
participant "Navegador\nEstación Recepción" as NavR
actor Recepcionista
actor Paciente

== Sincronización entre estaciones (RF-07) ==
par publicación y exhibición en Estación Paciente
  NavP -> BC : postMessage(MESSAGE)\n(mismo origen, sin red)
  NavP -> NavP : exhibir texto (1000 ms)\nluego reproducir audio
else propagación a Estación Recepción
  BC -> NavR : evento MESSAGE
  NavR -> Recepcionista : mostrar mensaje (ChatBubble)
end

== Respuesta del recepcionista (RF-08, RF-09) ==
Recepcionista -> NavR : escribe o dicta respuesta
NavR -> BC : postMessage(MESSAGE)
BC -> NavP : evento MESSAGE
NavP -> Paciente : mostrar respuesta (ChatBubble)

@enduml
