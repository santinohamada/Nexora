@startuml 06_vista_fisica
!include _estilo.iuml

title Vista Física — LSA Salud (estación fija de doble cara)

node "PC del puesto de atención" as PC {

  node "Navegador (Chrome)" as Browser {
    node "Estación Paciente\n/paciente" as TabP
    node "Estación Recepción\n/recepcion" as TabR
  }

  node "Next.js\n:3000" as NextServer

  node "FastAPI (Uvicorn)\n:8000" as Backend {
    artifact "app.py"
    artifact "lstm.py"
    artifact "Piper TTS" as PiperArt
  }

  node "Ollama\n:11434" as OllamaNode

  database "Archivos locales" as FS {
    folder "dataset/"
    folder "models/"
    folder "voices/"
    folder "logs/ «diseñado»" as LogsFolder
  }
}

TabP ..> NextServer : HTTP
TabR ..> NextServer : HTTP
TabP --> Backend : WS + HTTP
TabR --> Backend : HTTP
TabP <--> TabR : BroadcastChannel
Backend --> OllamaNode : HTTP
Backend ..> FS : lee/escribe

@enduml
