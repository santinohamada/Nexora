% ============================================================================
% lsasalud-pf.sty — Estilo del informe de Proyecto Final de LSA Salud
% (UTN — Facultad Regional Tucumán). Variante de docs/TP7/lsasalud.sty
% para la clase report: capítulos en lugar de partes, carátula según la
% Ord. 1825 y la plantilla UTN-FRT 2023, y citas APA con biblatex.
%
% Compilación (desde docs/ProyectoFinal/):
%   latexmk -pdf -outdir=build "ProyectoFinal_LSA Salud.tex"
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lsasalud-pf}[2026/11/20 Estilo Proyecto Final LSA Salud]

% --- Paquetes base --------------------------------------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[english, spanish, es-tabla, es-noshorthands]{babel}
\RequirePackage{csquotes}
\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{xcolor}
\RequirePackage{multirow}
\RequirePackage{listings}
\RequirePackage{pgfgantt}
% Spanish month abbreviations for the Gantt calendar titles.
\renewcommand*{\pgfcalendarmonthshortname}[1]{\ifcase#1\or Ene\or Feb\or Mar\or Abr\or May\or Jun\or Jul\or Ago\or Sep\or Oct\or Nov\or Dic\fi}
\RequirePackage[titles]{tocloft}
\RequirePackage[expansion=false]{microtype}
\RequirePackage{xurl}
\RequirePackage[style=apa, backend=biber]{biblatex}
\RequirePackage{hyperref}

\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}
\tolerance=1200
\emergencystretch=2em

% --- Geometría (márgenes de la plantilla UTN-FRT 2023) ----------------------
\geometry{left=3cm, right=2cm, top=2.75cm, bottom=2cm}

% --- Colores e hipervínculos -------------------------------------------------
\definecolor{ieeeblue}{RGB}{0, 51, 102}
\definecolor{sectioncolor}{RGB}{30, 68, 138}
\definecolor{linkcolor}{RGB}{0, 102, 204}
\definecolor{codebg}{RGB}{245, 245, 250}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    urlcolor=linkcolor,
    citecolor=black,
    pdfsubject={Proyecto Final --- LSA Salud},
    pdfauthor={Hamada, García Tarcic, Véliz, Arnedo}
}

% --- Encabezado y pie ---------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textsc{LSA Salud}}
\fancyhead[R]{\small\textsc{UTN-FRT}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

% --- Títulos ------------------------------------------------------------------
\setcounter{tocdepth}{2}
\setcounter{secnumdepth}{3}
\setlength{\cftchapnumwidth}{2em}
\titleformat{\chapter}[display]
    {\Huge\bfseries}
    {\LARGE\chaptertitlename{} \thechapter}
    {0.4em}{}[\vspace{0.2em}\rule{\linewidth}{1pt}]
\titlespacing*{\chapter}{0pt}{0pt}{1.5em}
\titleformat{\section}{\Large\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection.}{0.5em}{}

% --- Listados de código ---------------------------------------------------------
\lstset{
    backgroundcolor=\color{codebg},
    basicstyle=\small\ttfamily,
    breaklines=true,
    frame=single,
    rulecolor=\color{gray!30},
    numbers=left,
    numberstyle=\tiny\color{gray},
    tabsize=2,
    showstringspaces=false
}

% --- Marcador de contenido pendiente -------------------------------------------
% \pendiente{qué va acá y de qué TP sale}. Antes de entregar, buscar
% "\pendiente" en capitulos/: no debe quedar ninguno.
\newcommand{\pendiente}[1]{{\color{red}\itshape [Pendiente: #1]}\par}

