# Copy to .env (not versioned) and fill in. Variables already set in the environment take precedence.

# Shared dataset root, e.g. a Google Drive for desktop synced folder (contains custom/ and custom_blendshapes/).
# Unset: the repo's dataset/ folder.
NEXORA_DATASET_DIR=G:\Mi unidad\Nexora\dataset

# Your name, appended to every sample you record: <timestamp>_<name>.npy (letters, digits and '-', max 32).
NEXORA_RECORDER=
